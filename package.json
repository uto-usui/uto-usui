{
  "name": "uto-usui",
  "version": "3.0.0",
  "description": "uto usui portfolio",
  "author": "uto-usui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && stylelint \"src/**/*.{astro,scss}\" --allow-empty-input",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{astro,scss}\" --allow-empty-input --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:dist": "vitest run --project dist",
    "test:e2e": "playwright test",
    "visual:capture": "node scripts/visual/capture.ts",
    "visual:compare": "node scripts/visual/compare.ts",
    "xserver:pull": "node scripts/xserver/cli.ts pull",
    "xserver:diff": "node scripts/xserver/cli.ts diff",
    "xserver:deploy": "node scripts/xserver/cli.ts deploy",
    "xserver:rollback": "node scripts/xserver/cli.ts rollback",
    "xserver:check": "node scripts/xserver/cli.ts check",
    "xserver:auto:install": "bash scripts/xserver/launchagent/install.sh",
    "xserver:auto:uninstall": "bash scripts/xserver/launchagent/uninstall.sh",
    "verify": "pnpm lint && pnpm format:check && pnpm check && pnpm test && pnpm build && pnpm test:dist && pnpm test:e2e"
  },
  "dependencies": {
    "astro": "7.4.2",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "sass": "1.106.1",
    "shuffle-text": "0.6.0",
    "splitting": "1.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pngjs": "6.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "linkedom": "0.18.14",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "stylelint": "17.16.0",
    "stylelint-config-recess-order": "7.9.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
