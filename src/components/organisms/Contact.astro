---
import Title from '../atoms/Title.astro'

const email = 'me@uto-usui.com'
const crazy = Array(8).fill('🐈 crazy days / crazy feeling').join(' ') + ' 🐈'
---

<section class="organism-contact">
  <div class="ac__texts">
    <p
      class="oc__email"
      data-scroll
      data-scroll-speed="1"
      data-scroll-direction="horizontal"
    >
      <a class="oc__target" href={`mailto:${email}`} target="_blank">
        {[email, email, email].join(' ')}
      </a>
    </p>
    <p
      class="oc__crazy"
      data-scroll
      data-scroll-speed="-1"
      data-scroll-direction="horizontal"
      aria-hidden="true"
    >
      {crazy}
    </p>
  </div>

  <div class="oo__title">
    <Title text="_Get In Touch" />
  </div>
</section>

<style lang="scss">
  .organism-contact {
    position: relative;
    min-height: 100vh;
  }

  .ac__texts {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    white-space: nowrap;
    transform: translateX(-5%) translateY(-50%);
  }

  .oc__email {
    font-style: italic;
    opacity: 0.7;

    @include sizes(5);

    @include desktop {
      @include sizes(7);
    }
  }

  .oc__crazy {
    font-style: italic;
    opacity: 0.7;

    @include sizes(-1);

    @include desktop {
      @include sizes(1);
    }
  }

  .oo__title {
    position: absolute;
    right: 0;
    bottom: 0;
  }
</style>
