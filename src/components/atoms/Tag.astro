---
interface Props {
  text: string
}
const { text } = Astro.props
---

<p class="atom-tag">{text}</p>

<style lang="scss">
  .atom-tag {
    display: inline-block;
    font-style: italic;
    letter-spacing: 0.05rem;
    border-top: 1px solid currentcolor;
    border-bottom: 1px solid currentcolor;

    @include sizes(-2, 3);
  }
</style>
